NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://fit_district:YOUR_PASSWORD@127.0.0.1:5432/fit_district
# true in production; provide the server CA. Certificate verification stays enabled.
DATABASE_SSL=false
DATABASE_CA_FILE=
# Generate separate random secrets using scripts/setupEnv.js. Never reuse these keys.
JWT_SECRET=
CODE_SECRET=
CSRF_SECRET=
FIELD_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional local development only: file writes codes to Backend/.mailbox/ for testing.
# This does not verify email ownership. Production requires smtp.
MAIL_TRANSPORT=smtp
# Run exactly one backend process until an external shared IP limiter is configured.
TRUST_PROXY_HOPS=0
